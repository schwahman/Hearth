[Unit]
Description=Hearth chat server
After=network-online.target
Wants=network-online.target

[Service]
User=hearth
Group=hearth
WorkingDirectory=/opt/hearth
EnvironmentFile=/etc/hearth.env
ExecStart=/usr/local/bin/node --no-warnings server/index.js
Restart=always
RestartSec=2
# Allow binding to ports 80/443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Sandboxing: the service can only write to its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hearth
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
